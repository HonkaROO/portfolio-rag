# URL of the deployed FastAPI backend (Render, etc). Point to localhost:8000 during local dev.
VITE_API_URL=https://your-backend.onrender.com

# Contact form: sign up free at formspree.io, create a form, and paste its ID here
# (the part after /f/ in the endpoint URL it gives you).
VITE_FORMSPREE_ID=your-form-id
